# Python
venv/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl

# Node.js
node_modules/
app/frontend/dist/

# Built frontend served by backend
app/backend/static/*
!app/backend/static/.gitkeep

# Temp and output files
app/temp/
app/output/

# Built Electron app (entire portable bundle)
Utai/

# External tools (bundled, not source-managed)
# ffmpeg / ffprobe binaries (anywhere in tree)
**/ffmpeg.exe
**/ffprobe.exe
bin/*.dll

# yt-dlp source (cloned separately)
yt-dlp/

# MSST
# MSST virtual environment
MSST/.venv/

# Downloaded separation models (users download their own)
MSST/pretrain/vocal_models/*.ckpt
MSST/pretrain/vocal_models/*.pth
MSST/pretrain/vocal_models/*.th
MSST/pretrain/multi_stem_models/*.ckpt
MSST/pretrain/multi_stem_models/*.pth
MSST/pretrain/multi_stem_models/*.th
MSST/pretrain/single_stem_models/*.ckpt
MSST/pretrain/single_stem_models/*.pth
MSST/pretrain/single_stem_models/*.th
MSST/pretrain/VR_Models/*.pth
MSST/tmpdir/

# RVC
# User-trained models and training data
RVC/*/assets/weights/*.pth
RVC/*/assets/indices/*.index
RVC/*/logs/
!RVC/*/logs/mute/

# Pretrained base models (large, downloaded separately)
RVC/**/assets/pretrained/*.pth
RVC/**/assets/pretrained_v2/*.pth
RVC/**/assets/hubert/*.pt
RVC/**/assets/hubert/*.pth
RVC/**/assets/rmvpe/*.pt
RVC/**/assets/rmvpe/*.pth
RVC/**/assets/rmvpe/*.onnx
RVC/**/assets/*.pth

# VST plugins (user-managed — large binaries, samples, state files)
# Raw plugin directories (users bring their own .dll/.vst3)
VST/4fpiano-win/
VST/AmpleBass/
VST/AmpleGuitar/
VST/MTPDK*/
VST/Sonatina_*/
VST/Dexed*/
VST/*.clap
VST/*.exe
# Imported plugins (generated on import — user-specific)
VST/instruments/*/
# JUCE framework (cloned separately)
VST/juce/
# JUCE host build artifacts
VST/host/build/
VST/host/UtaiVSTHost.exe

# Synth (UtaiSynth — DiffSinger + OpenUtau integration)
# Pre-compiled renderer binaries (large, platform-specific, rebuild from utai-renderer-src/)
synth/utai-renderer/**/*.exe
synth/utai-renderer/**/*.dll
synth/utai-renderer/**/*.so
synth/utai-renderer/**/*.dylib
synth/utai-renderer/**/*.pdb
synth/utai-renderer/**/*.lib
synth/utai-renderer/runtimes/
synth/utai-renderer/Cache/
synth/utai-renderer/notepresets.json
# OpenUtau source (cloned for building renderer, not committed)
synth/OpenUtau-DiffSinger-Lunai/
# Renderer build artifacts
synth/utai-renderer-src/bin/
synth/utai-renderer-src/obj/
# DiffSinger voice banks (large, user-managed via Model Manager)
synth/Singers/*/
synth/utai-renderer/Singers/*/
# UtaiSynthesizer standalone (reference only, to be removed)
UtaiSynthesizer/

# Electron
electron/node_modules/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.claude/

# OS
Thumbs.db
Desktop.ini
.DS_Store
ehthumbs.db

# Experiments (isolated from main codebase)
experiments/

# Environment / Secrets
.env
.env.*
*.log
